/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}
Connector {Xa, Xb, Xd}

Resource {PCGen, Decoder, JumpDecoder, ALU, LSU, CSR}
Resource {MUL, MULH(5)}
Resource {DIV(divider), DIVU(divider_u)}
Resource {IPort_R, DPort_R, DPort_W}

// = XISAAC Resources =
virtual Resource {
    vCUSTOM0_I,
    vCUSTOM0_X,
    vCUSTOM0_O,
    vCUSTOM8_I,
    vCUSTOM8_X,
    vCUSTOM8_O,
    vCUSTOM13_I,
    vCUSTOM13_X,
    vCUSTOM13_O,
    vCUSTOM14_I,
    vCUSTOM14_X,
    vCUSTOM14_O
}

Resource {CUSTOM0_I(1), CUSTOM0_X(0), CUSTOM0_O(0)}
Resource {CUSTOM8_I(1), CUSTOM8_X(0), CUSTOM8_O(0)}
Resource {CUSTOM13_I(1), CUSTOM13_X(0), CUSTOM13_O(0)}
Resource {CUSTOM14_I(1), CUSTOM14_X(0), CUSTOM14_O(0)}

// --------------------

Microaction {
  uA_IFetch        (Pc -> IPort_R),
  uA_PCGen         (Pc -> PCGen -> Pc_p),
  uA_Decode        (Decoder),
  uA_JumpDecode    (JumpDecoder -> Pc_np),
  uA_JumpDecodeReg (Xa -> JumpDecoder -> Pc_np),
  uA_OF_A          (Xa),
  uA_OF_B          (Xb),
  uA_ALU_RegUpdate (ALU -> Xd),
  uA_ALU_Branch    (ALU -> Pc_np),
  uA_CSR           (CSR -> Xd),
  uA_LSU           (LSU),
  uA_MUL           (MUL -> Xd),
  uA_MULH          (MULH -> Xd),
  uA_DIV           (DIV -> Xd),
  uA_DIVU          (DIVU -> Xd),
  uA_Memory_R      (DPort_R -> Xd),
  uA_Memory_W      (DPort_W)
}

// = XISAAC Microactions =
virtual Microaction {
    vuA_CUSTOM0_I,
    vuA_CUSTOM0_X,
    vuA_CUSTOM0_O,
    vuA_CUSTOM8_I,
    vuA_CUSTOM8_X,
    vuA_CUSTOM8_O,
    vuA_CUSTOM13_I,
    vuA_CUSTOM13_X,
    vuA_CUSTOM13_O,
    vuA_CUSTOM14_I,
    vuA_CUSTOM14_X,
    vuA_CUSTOM14_O

}
Microaction {
    uA_CUSTOM0_I    (CUSTOM0_I),
    uA_CUSTOM0_X    (CUSTOM0_X),
    uA_CUSTOM0_O    (CUSTOM0_O -> Xd),
    uA_CUSTOM8_I    (CUSTOM8_I),
    uA_CUSTOM8_X    (CUSTOM8_X),
    uA_CUSTOM8_O    (CUSTOM8_O -> Xd),
    uA_CUSTOM13_I    (CUSTOM13_I),
    uA_CUSTOM13_X    (CUSTOM13_X),
    uA_CUSTOM13_O    (CUSTOM13_O -> Xd),
    uA_CUSTOM14_I    (CUSTOM14_I),
    uA_CUSTOM14_X    (CUSTOM14_X),
    uA_CUSTOM14_O    (CUSTOM14_O -> Xd)

}
// -----------------------

/************************************ Stages & Pipeline ************************************/

Stage {
    EX_substage_CUSTOM0_I  (vuA_CUSTOM0_I),
    EX_substage_CUSTOM0_X  (vuA_CUSTOM0_X),
    EX_substage_CUSTOM0_O  (vuA_CUSTOM0_O),
    EX_substage_CUSTOM8_I  (vuA_CUSTOM8_I),
    EX_substage_CUSTOM8_X  (vuA_CUSTOM8_X),
    EX_substage_CUSTOM8_O  (vuA_CUSTOM8_O),
    EX_substage_CUSTOM13_I  (vuA_CUSTOM13_I),
    EX_substage_CUSTOM13_X  (vuA_CUSTOM13_X),
    EX_substage_CUSTOM13_O  (vuA_CUSTOM13_O),
    EX_substage_CUSTOM14_I  (vuA_CUSTOM14_I),
    EX_substage_CUSTOM14_X  (vuA_CUSTOM14_X),
    EX_substage_CUSTOM14_O  (vuA_CUSTOM14_O)
}

Pipeline {
    EX_subpipe_CUSTOM0 (EX_substage_CUSTOM0_I -> EX_substage_CUSTOM0_X -> EX_substage_CUSTOM0_O),
    EX_subpipe_CUSTOM8 (EX_substage_CUSTOM8_I -> EX_substage_CUSTOM8_X -> EX_substage_CUSTOM8_O),
    EX_subpipe_CUSTOM13 (EX_substage_CUSTOM13_I -> EX_substage_CUSTOM13_X -> EX_substage_CUSTOM13_O),
    EX_subpipe_CUSTOM14 (EX_substage_CUSTOM14_I -> EX_substage_CUSTOM14_X -> EX_substage_CUSTOM14_O)
}


Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM0,
    EX_subpipe_CUSTOM8,
    EX_subpipe_CUSTOM13,
    EX_subpipe_CUSTOM14,

    // -------------------
    uA_DIV,
    uA_DIVU
),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  
  
  XIsaac_CUSTOM8 (custom8),  
  
  XIsaac_CUSTOM14 (custom14),  
  
  XIsaac_CUSTOM0 (custom0),  
  
  XIsaac_CUSTOM13 (custom13)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {

  XIsaac_CUSTOM0 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM0_I, vuA_CUSTOM0_X, vuA_CUSTOM0_O},

  XIsaac_CUSTOM8 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM8_I, vuA_CUSTOM8_X, vuA_CUSTOM8_O},

  XIsaac_CUSTOM13 : {uA_Decode, uA_OF_A, vuA_CUSTOM13_I, vuA_CUSTOM13_X, vuA_CUSTOM13_O},

  XIsaac_CUSTOM14 : {uA_Decode, uA_OF_A, vuA_CUSTOM14_I, vuA_CUSTOM14_X, vuA_CUSTOM14_O}

}
// ------------------------------


TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  // = XISAAC Trace Value Mapping =
  XIsaac_CUSTOM0 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM8 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM13 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}"
  },
  XIsaac_CUSTOM14 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}"
  },

  // ------------------------------
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },
  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U"
  }
}

/**************************************** Variants *****************************************/
// Variant: None

CorePerfModel CV32E40PXISAAC (
  core : "XIsaacCore"
  use Pipeline : CV32E40PXISAAC_pipeline
  use ConnectorModel : {regModel, staBranchPredModel}
  assign Resource : {
    vCUSTOM0_I = CUSTOM0_I,
    vCUSTOM0_X = CUSTOM0_X,
    vCUSTOM0_O = CUSTOM0_O,
    vCUSTOM8_I = CUSTOM8_I,
    vCUSTOM8_X = CUSTOM8_X,
    vCUSTOM8_O = CUSTOM8_O,
    vCUSTOM13_I = CUSTOM13_I,
    vCUSTOM13_X = CUSTOM13_X,
    vCUSTOM13_O = CUSTOM13_O,
    vCUSTOM14_I = CUSTOM14_I,
    vCUSTOM14_X = CUSTOM14_X,
    vCUSTOM14_O = CUSTOM14_O
  }
  assign Microaction : {
    vuA_CUSTOM0_I = uA_CUSTOM0_I,
    vuA_CUSTOM0_X = uA_CUSTOM0_X,
    vuA_CUSTOM0_O = uA_CUSTOM0_O,
    vuA_CUSTOM8_I = uA_CUSTOM8_I,
    vuA_CUSTOM8_X = uA_CUSTOM8_X,
    vuA_CUSTOM8_O = uA_CUSTOM8_O,
    vuA_CUSTOM13_I = uA_CUSTOM13_I,
    vuA_CUSTOM13_X = uA_CUSTOM13_X,
    vuA_CUSTOM13_O = uA_CUSTOM13_O,
    vuA_CUSTOM14_I = uA_CUSTOM14_I,
    vuA_CUSTOM14_X = uA_CUSTOM14_X,
    vuA_CUSTOM14_O = uA_CUSTOM14_O
  }
)

// --------------------
