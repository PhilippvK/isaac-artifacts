}

Pipeline {
    EX_subpipe_CUSTOM2 (EX_substage_CUSTOM2_I -> EX_substage_CUSTOM2_X -> EX_substage_CUSTOM2_O),
    EX_subpipe_CUSTOM5 (EX_substage_CUSTOM5_I -> EX_substage_CUSTOM5_X -> EX_substage_CUSTOM5_O),
    EX_subpipe_CUSTOM9 (EX_substage_CUSTOM9_I -> EX_substage_CUSTOM9_X -> EX_substage_CUSTOM9_O),
    EX_subpipe_CUSTOM21 (EX_substage_CUSTOM21_I -> EX_substage_CUSTOM21_X -> EX_substage_CUSTOM21_O),
    EX_subpipe_CUSTOM27 (EX_substage_CUSTOM27_I -> EX_substage_CUSTOM27_X -> EX_substage_CUSTOM27_O),
    EX_subpipe_CUSTOM29 (EX_substage_CUSTOM29_I -> EX_substage_CUSTOM29_X -> EX_substage_CUSTOM29_O),
    EX_subpipe_CUSTOM31 (EX_substage_CUSTOM31_I -> EX_substage_CUSTOM31_X -> EX_substage_CUSTOM31_O),
    EX_subpipe_CUSTOM33 (EX_substage_CUSTOM33_I -> EX_substage_CUSTOM33_X -> EX_substage_CUSTOM33_O),
    EX_subpipe_CUSTOM35 (EX_substage_CUSTOM35_I -> EX_substage_CUSTOM35_X -> EX_substage_CUSTOM35_O),
    EX_subpipe_CUSTOM37 (EX_substage_CUSTOM37_I -> EX_substage_CUSTOM37_X -> EX_substage_CUSTOM37_O)
}


Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM2,
    EX_subpipe_CUSTOM5,
    EX_subpipe_CUSTOM9,
    EX_subpipe_CUSTOM21,
    EX_subpipe_CUSTOM27,
    EX_subpipe_CUSTOM29,
    EX_subpipe_CUSTOM31,
    EX_subpipe_CUSTOM33,
    EX_subpipe_CUSTOM35,
    EX_subpipe_CUSTOM37,

    // -------------------
    uA_DIV,
    uA_DIVU
),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  
  
  XIsaac_CUSTOM2 (custom2),  
  
  XIsaac_CUSTOM5 (custom5),  
  
  XIsaac_CUSTOM9 (custom9),  
  
  XIsaac_CUSTOM21 (custom21),  
  
  XIsaac_CUSTOM27 (custom27),  
  
  XIsaac_CUSTOM29 (custom29),  
  
  XIsaac_CUSTOM31 (custom31),  
  
  XIsaac_CUSTOM33 (custom33),  
  
  XIsaac_CUSTOM35 (custom35),  
  
  XIsaac_CUSTOM37 (custom37)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {

  XIsaac_CUSTOM2 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM2_I, vuA_CUSTOM2_X, vuA_CUSTOM2_O},

  XIsaac_CUSTOM5 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM5_I, vuA_CUSTOM5_X, vuA_CUSTOM5_O},

  XIsaac_CUSTOM9 : {uA_Decode, uA_OF_A, vuA_CUSTOM9_I, vuA_CUSTOM9_X, vuA_CUSTOM9_O},

  XIsaac_CUSTOM21 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM21_I, vuA_CUSTOM21_X, vuA_CUSTOM21_O},

  XIsaac_CUSTOM27 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM27_I, vuA_CUSTOM27_X, vuA_CUSTOM27_O},

  XIsaac_CUSTOM29 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM29_I, vuA_CUSTOM29_X, vuA_CUSTOM29_O},

  XIsaac_CUSTOM31 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM31_I, vuA_CUSTOM31_X, vuA_CUSTOM31_O},

  XIsaac_CUSTOM33 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM33_I, vuA_CUSTOM33_X, vuA_CUSTOM33_O},

  XIsaac_CUSTOM35 : {uA_Decode, uA_OF_A, vuA_CUSTOM35_I, vuA_CUSTOM35_X, vuA_CUSTOM35_O},

  XIsaac_CUSTOM37 : {uA_Decode, uA_OF_A, vuA_CUSTOM37_I, vuA_CUSTOM37_X, vuA_CUSTOM37_O}

}
// ------------------------------


TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  // = XISAAC Trace Value Mapping =
  XIsaac_CUSTOM2 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM5 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM9 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}"
  },
  XIsaac_CUSTOM21 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM27 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM29 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM31 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM33 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM35 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}"
  },
  XIsaac_CUSTOM37 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}"
  },

  // ------------------------------
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },
  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U"
  }
}

