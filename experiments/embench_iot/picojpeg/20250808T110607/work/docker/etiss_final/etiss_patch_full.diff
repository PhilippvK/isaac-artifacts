+ *
+ * This file contains the architecture specific implementation for the XIsaacCore
+ * core architecture.
+ *
+ * WARNING: This file contains user-added code, be mindful when overwriting this with
+ * generated code!
+ */
+
+#include <vector>
+
+#include "XIsaacCoreArch.h"
