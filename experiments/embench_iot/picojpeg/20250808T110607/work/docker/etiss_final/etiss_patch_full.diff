+// IMPORTANT this name MUST match the library name: e.g. X -> libX.so
+
+#define ETISS_LIBNAME XIsaacCore
+#include "etiss/helper/CPUArchLibrary.h" // defines the following functions
+#include "XIsaacCoreArch.h"
