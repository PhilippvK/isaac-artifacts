+extern "C" {
+
+	ETISS_LIBRARYIF_VERSION_FUNC_IMPL
+
+	ETISS_PLUGIN_EXPORT unsigned XIsaacCore_countCPUArch()
+	{
+//TODO
+		return 1; // number of cpu architectures provided
+	}
+	ETISS_PLUGIN_EXPORT const char * XIsaacCore_nameCPUArch(unsigned index)
+	{
+//TODO
+		switch (index)
+		{
+		case 0:
+			return "XIsaacCore";
+		default:
+			return "";
+		}
+	}
+	ETISS_PLUGIN_EXPORT etiss::CPUArch* XIsaacCore_createCPUArch(unsigned index,std::map<std::string,std::string> options)
+	{
+//TODO
+		switch (index)
+		{
+		case 0:
+			{
+				auto it = options.find("coreno");
+				unsigned int coreno = 0;
+				if (it != options.end())
+					coreno = std::stoul(it->second);
+				else
+					etiss::log(etiss::WARNING, "no core number provided for core, using 0");
+
+				return new XIsaacCoreArch(coreno);
+			}
+		default:
+			return 0;
+		}
+	}
+	ETISS_PLUGIN_EXPORT void XIsaacCore_deleteCPUArch(etiss::CPUArch* arch)
+	{
+		delete arch;
+	}
+}
