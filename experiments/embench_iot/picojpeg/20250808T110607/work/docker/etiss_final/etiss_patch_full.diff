+std::shared_ptr<etiss::VirtualStruct> XIsaacCoreArch::getVirtualStruct(ETISS_CPU * cpu)
+{
+	auto ret = etiss::VirtualStruct::allocate(
+		cpu,
+		[] (etiss::VirtualStruct::Field*f) {
+			delete f;
+		}
+	);
+
+	for (uint32_t i = 0; i < 32; ++i){
+		ret->addField(new RegField_XIsaacCore(*ret,i));
+	}
+
+	ret->addField(new pcField_XIsaacCore(*ret));
+	return ret;
+}
+
+/**
+	@brief If interrupt handling is expected, vector table could be provided to support interrupt triggering
+
+	@details Interrupt vector table is used to inform the core whenever an edge/level triggered interrupt
+				incoming. The content of interrupt vector could be a special register or standalone interrupt
+				lines.
+*/
+etiss::InterruptVector * XIsaacCoreArch::createInterruptVector(ETISS_CPU * cpu)
+{
+	if (cpu == 0)
+		return 0;
+
+	std::vector<etiss::uint32 *> vec;
+	std::vector<etiss::uint32 *> mask;
+
+	vec.push_back(&((XIsaacCore*)cpu)->MIP);
+	mask.push_back(&((XIsaacCore*)cpu)->MIE);
+
+	return new etiss::MappedInterruptVector<etiss::uint32>(vec, mask);
+}
+
+void XIsaacCoreArch::deleteInterruptVector(etiss::InterruptVector * vec, ETISS_CPU * cpu)
+{
+	delete vec;
+}
+
+etiss::InterruptEnable* XIsaacCoreArch::createInterruptEnable(ETISS_CPU* cpu) {
+ 	return new etiss::MappedInterruptEnable<etiss::uint32>(&((XIsaacCore*)cpu)->MSTATUS, 15);
+}
+
+void XIsaacCoreArch::deleteInterruptEnable(etiss::InterruptEnable* en, ETISS_CPU* cpu) {
+	delete en;
+}
