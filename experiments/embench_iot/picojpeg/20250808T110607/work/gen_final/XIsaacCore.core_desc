import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/rv_base/RVI.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/rv_base/RVC.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/rv_base/RVM.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/tum_mod.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/rv_base/RVF.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/out/embench_iot/picojpeg/20250808T110607/work/gen_final/XIsaac.core_desc"
import "/work/git/students/tuw/michael/isaac-demo/etiss_arch_riscv/rv_base/RVD.core_desc"

Core XIsaacCore provides RV32I, RV32IC, RV32M, RV32F, RV32FC, RV32D, RV32DC, Zifencei, tum_rva, tum_csr, tum_semihosting, tum_ret, XIsaac {
    architectural_state {
        CSR[0x000] = 0x0000000B; // ustatus
        CSR[RV_CSR_SSTATUS] = 0x0000000B; // sstatus
        CSR[RV_CSR_MSTATUS] = 0x0000000B; // mstatus
        
        CSR[RV_CSR_MISA] = 0x4014112D; // misa
        
        CSR[0xC10] = 0x00000003;
        
        CSR[RV_CSR_MIE] = 0xFFFFFBBB; // mie
        CSR[RV_CSR_SIE] = CSR[0x304] & (~(0x888)); // sie
        CSR[0x004] = CSR[0x304] & (~(0xAAA)); // uie
    }
}
