/************************************ Stages & Pipeline ************************************/

Stage {
    EX_substage_CUSTOM2_I  (vuA_CUSTOM2_I),
    EX_substage_CUSTOM2_X  (vuA_CUSTOM2_X),
    EX_substage_CUSTOM2_O  (vuA_CUSTOM2_O),
    EX_substage_CUSTOM8_I  (vuA_CUSTOM8_I),
    EX_substage_CUSTOM8_X  (vuA_CUSTOM8_X),
    EX_substage_CUSTOM8_O  (vuA_CUSTOM8_O),
    EX_substage_CUSTOM17_I  (vuA_CUSTOM17_I),
    EX_substage_CUSTOM17_X  (vuA_CUSTOM17_X),
    EX_substage_CUSTOM17_O  (vuA_CUSTOM17_O),
    EX_substage_CUSTOM24_I  (vuA_CUSTOM24_I),
    EX_substage_CUSTOM24_X  (vuA_CUSTOM24_X),
    EX_substage_CUSTOM24_O  (vuA_CUSTOM24_O),
    EX_substage_CUSTOM26_I  (vuA_CUSTOM26_I),
    EX_substage_CUSTOM26_X  (vuA_CUSTOM26_X),
    EX_substage_CUSTOM26_O  (vuA_CUSTOM26_O),
    EX_substage_CUSTOM28_I  (vuA_CUSTOM28_I),
    EX_substage_CUSTOM28_X  (vuA_CUSTOM28_X),
    EX_substage_CUSTOM28_O  (vuA_CUSTOM28_O)
}

Pipeline {
    EX_subpipe_CUSTOM2 (EX_substage_CUSTOM2_I -> EX_substage_CUSTOM2_X -> EX_substage_CUSTOM2_O),
    EX_subpipe_CUSTOM8 (EX_substage_CUSTOM8_I -> EX_substage_CUSTOM8_X -> EX_substage_CUSTOM8_O),
    EX_subpipe_CUSTOM17 (EX_substage_CUSTOM17_I -> EX_substage_CUSTOM17_X -> EX_substage_CUSTOM17_O),
    EX_subpipe_CUSTOM24 (EX_substage_CUSTOM24_I -> EX_substage_CUSTOM24_X -> EX_substage_CUSTOM24_O),
    EX_subpipe_CUSTOM26 (EX_substage_CUSTOM26_I -> EX_substage_CUSTOM26_X -> EX_substage_CUSTOM26_O),
    EX_subpipe_CUSTOM28 (EX_substage_CUSTOM28_I -> EX_substage_CUSTOM28_X -> EX_substage_CUSTOM28_O)
}


Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM2,
    EX_subpipe_CUSTOM8,
    EX_subpipe_CUSTOM17,
    EX_subpipe_CUSTOM24,
    EX_subpipe_CUSTOM26,
    EX_subpipe_CUSTOM28,

    // -------------------
    uA_DIV,
    uA_DIVU
),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  
  
  XIsaac_CUSTOM2 (custom2),  
  
  XIsaac_CUSTOM8 (custom8),  
  
  XIsaac_CUSTOM17 (custom17),  
  
  XIsaac_CUSTOM24 (custom24),  
  
  XIsaac_CUSTOM26 (custom26),  
  
  XIsaac_CUSTOM28 (custom28)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {

  XIsaac_CUSTOM2 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM2_I, vuA_CUSTOM2_X, vuA_CUSTOM2_O},

  XIsaac_CUSTOM8 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM8_I, vuA_CUSTOM8_X, vuA_CUSTOM8_O},

  XIsaac_CUSTOM17 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM17_I, vuA_CUSTOM17_X, vuA_CUSTOM17_O},

  XIsaac_CUSTOM24 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM24_I, vuA_CUSTOM24_X, vuA_CUSTOM24_O},

  XIsaac_CUSTOM26 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM26_I, vuA_CUSTOM26_X, vuA_CUSTOM26_O},

  XIsaac_CUSTOM28 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM28_I, vuA_CUSTOM28_X, vuA_CUSTOM28_O}

}
// ------------------------------


TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  // = XISAAC Trace Value Mapping =
  XIsaac_CUSTOM2 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM8 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM17 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM24 : {     
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",
    
    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",
    
    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM26 : {     
